{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "useUnknownInCatchVariables": true
  },
  "exclude": ["Telas", "node_modules", "android"]
}
